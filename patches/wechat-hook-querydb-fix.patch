+    static std::string stamp() {
+        SYSTEMTIME st;
+        GetLocalTime(&st);
+        char b[64];
+        _snprintf_s(b, sizeof(b), _TRUNCATE, "%02d:%02d:%02d.%03d",
+                    st.wHour, st.wMinute, st.wSecond, st.wMilliseconds);
