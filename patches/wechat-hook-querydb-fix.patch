+        long long n = ++counter;
+        if (g_log == nullptr) return;
+        if (n <= cap) {
+            g_log(line);
+        } else if (n == cap + 1) {
+            g_log("[PUSH] 该类日志已达上限 " + std::to_string(cap) + " 条，后续同类不再打印（计数继续）\r\n");
+        }
+    }
