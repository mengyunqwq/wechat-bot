+    int detourBindBlob64(sqlite3_stmt* s, int i, const void* p, sqlite3_uint64 n, void(*d)(void*)) {
+        int rc = g_origBindBlob64 ? g_origBindBlob64(s, i, p, n, d) : 1;
+        if (rc == SQLITE_OK) msgpush::bindValue(s, i, SQLITE_BLOB, p,
